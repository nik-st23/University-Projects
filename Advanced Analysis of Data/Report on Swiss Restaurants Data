    coef_vector <- coef_train_clust[[i]][[cl]][, 1]
    
    cluster_vars <- setdiff(rownames(coef_train_clust[[i]][[cl]]), "const")
    
   
    transform_cluster(coef_vector, test_data = result$test[[i]], cluster_vars = cluster_vars)
  })

  VarClust_test_data[[i]] <- as.data.frame(varclust_scores)

  colnames(VarClust_test_data[[i]]) <- clusters
}

