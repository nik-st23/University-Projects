# --- VAR CLUST TRANSFORM
transform_cluster <- function(coef_vector, test_data, cluster_vars) {
  # coef_vector: a named numeric vector (or one-column matrix converted to vector)
  #              where the first element is the constant ("const").
  # test_data: a data frame or matrix containing test observations.
  # cluster_vars: character vector of variable names for this cluster.
  
  # Ensure the test data columns are in the same order as in the coefficient vector (excluding "const")
  var_names <- setdiff(names(coef_vector), "const")
  
  test_subset <- test_data[, var_names, drop = FALSE]
  
  # Compute for each observation: constant + sum( variable * coefficient )
  transformed_scores <- apply(test_subset, 1, function(row_vals) {
    sum(coef_vector * as.numeric(c(1, row_vals)))
  })
  
  return(transformed_scores)
}

