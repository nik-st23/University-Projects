train_test_rest_mice <- function(n) {
  train_list_1 <- list()
  test_list_1 <- list()
  y_train <- list()
  y_test <- list()
  
  for (i in 1:n) {
    train_ind <- sample(seq_len(nrow(rest_mice_1)), size = smp_size)
    # Save response values (assumed to be in the first column)
    y_train[[i]] <- rest_mice_5[train_ind, 1]
    y_test[[i]]  <- rest_mice_5[-train_ind, 1]
    # Save predictors (all columns except the first)
    train_list_1[[i]] <- rest_mice_5[train_ind, -1]
    test_list_1[[i]]  <- rest_mice_5[-train_ind, -1]
  }
  return(list(train = train_list_1, test = test_list_1, y_train = y_train, y_test = y_test))
}

